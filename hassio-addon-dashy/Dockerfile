FROM lissy93/dashy:4.6.14

# 1. Переключаемся на root, так как базовый образ использует пользователя node
USER root

# 2. Выполняем настройку постоянного хранилища
RUN mkdir -p /data && \
    # Копируем стандартный конфиг в постоянное хранилище (если его там еще нет)
    cp -n /app/user-data/conf.yml /data/conf.yml 2>/dev/null || true && \
    # Выдаем права пользователю node (UID 1000), под которым работает Dashy
    chown -R 1000:1000 /data && \
    # Удаляем стандартную папку и создаем символическую ссылку на /data
    rm -rf /app/user-data && \
    ln -s /data /app/user-data

# 3. Возвращаем пользователя node для безопасного запуска приложения (как в базовом образе)
USER node
